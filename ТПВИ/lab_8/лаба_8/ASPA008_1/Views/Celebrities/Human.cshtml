@using DAL_Celebrity_MSSQL
@using System.Globalization
@using ASPA008_1.Helpers;
@model ASPA008_1.Controllers.CelebritiesController.HumanModel

@{
    // Views/Celebrities/Human.cshtml
    Layout = "_CelebritiesLayout";
    Celebrity celebrity = Model.celebrity;
    Dictionary<string, string> references = Model.references ?? new Dictionary<string, string>();
    string photopath = $"{Model.photosrequestpath}/{celebrity.ReqPhotoPath}";
}

@section subhead {}

<div style="display:flex; gap: 20px;">
    <div class="celebrity-box">
        @{
            // Модель передает словарь ссылок. Берем первую.

            string wikiUrl = Model.references?.Values.FirstOrDefault() ?? "#";

            bool hasWiki = Model.references != null && Model.references.Count > 0;
        }

        @if (hasWiki)

        {
            @* Оборачиваем фото в ссылку *@
            <a href="@wikiUrl" target="_blank" title="Перейти в Wikipedia" style="display: inline-block;">
                @Html.CelebrityPhoto(celebrity.Id, celebrity.FullName, photopath)
            </a>
        }

        else

        {
            @Html.CelebrityPhoto(celebrity.Id, celebrity.FullName, photopath)
        }
    </div>

    <div class="celebrity-box" style="flex: 1;">
        <h2>@celebrity.FullName</h2>

        @foreach (Lifeevent live in Model.lifeevents)

        {
            <p><strong>@live.Date?.ToString("dd.MM.yyyy")</strong> @live.Description</p>
        }

        @* Блок кнопок управления *@
        <div class="mt-3">
            <a href="@Url.Action("Edit", "Celebrities", new { id = celebrity.Id })" class="btn btn-secondary">Редактировать</a>
            <a href="@Url.Action("ConfirmDelete", "Celebrities", new { id = celebrity.Id })" class="btn btn-danger">Удалить</a>
        </div>

        @* Дополнительные ссылки из Википедии (кнопки внизу) *@
        <div class="mt-3">
            @foreach (var info in references)
            {
                <a href="@info.Value" target="_blank" class="btn btn-outline-info btn-sm">@info.Key</a>
            }
        </div>
    </div>
</div>

@section foot{}
